apiVersion: v1
kind: Secret
metadata:
  name: fixbot-db-secret
  namespace: fixbot
type: Opaque
stringData:
  username: "YOUR_DB_USERNAME"
  password: "YOUR_DB_PASSWORD"
  database: "YOUR_DB_NAME"
  host: "YOUR_DB_HOST"
  port: "YOUR_DB_PORT"

---
apiVersion: v1
kind: Secret
metadata:
  name: fixbot-api-secret
  namespace: fixbot
type: Opaque
stringData:
  claude-api-key: "YOUR_CLAUDE_API_KEY"

---
apiVersion: v1
kind: Secret
metadata:
  name: fixbot-github-secret
  namespace: fixbot
type: Opaque
stringData:
  client-id: "YOUR_GITHUB_OAUTH_CLIENT_ID"
  client-secret: "YOUR_GITHUB_OAUTH_CLIENT_SECRET"
